# Environment Mode (development / production)
NODE_ENV=development
DISABLE_MOCK_FALLBACK=false

# Server Port
PORT=5000

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_POOL_SIZE=50
NEO4J_ACQUISITION_TIMEOUT_MS=15000
NEO4J_LIFETIME_MS=3600000

# Qdrant Vector Storage Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_MS=10000

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# n8n Ingestion Webhook Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/talentos-ingestion

